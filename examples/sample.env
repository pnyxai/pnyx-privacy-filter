# ──────────────────────────────────────────────────────────────────────────────
# sample.env  —  copy to .env and fill in real values before running
#                docker compose up
# ──────────────────────────────────────────────────────────────────────────────

# HF_TOKEN=hf_xxx  # If your model repository is private, set this to a Hugging Face token with access.

# ------------------------------------------------------------------------------
# Triton privacy-filter service (pnyx-pf-triton)
# ------------------------------------------------------------------------------

# Model repository type — selects the sub-folder inside /model_configs that
# gets copied into /models at container startup.
TRITON_MODEL_TYPE=pnyx-pf

# Maximum number of requests batched in a single inference call.
TRITON_MAX_BATCH_SIZE=2

# Number of model instances loaded per GPU/CPU.
TRITON_INSTANCE_COUNT=1

# Maximum token sequence length accepted by the model.
TRITON_MAX_SEQUENCE_LENGTH=65536

# Absolute path on the **host** where the model weights live.
# This directory is bind-mounted to /mnt/models inside the container.
# Example: /home/user/models/privacy-filter
TRITON_MODELS_PATH=/path/to/pnyx-privacy-filter/untracked/privacy-filter

# Comma-separated list of  source=dest  weight symlink mappings.
# source: path relative to /mnt/models
# dest:   path relative to /models  (created as a symlink)
TRITON_WEIGHT_MAPPINGS=onnx/model.onnx=main_model/1/model.onnx,onnx/model.onnx_data=main_model/1/model.onnx_data,onnx/model.onnx_data_1=main_model/1/model.onnx_data_1,onnx/model.onnx_data_2=main_model/1/model.onnx_data_2

# ------------------------------------------------------------------------------
# PrivateChatManager service (pnyx-pcm)
# ------------------------------------------------------------------------------

# Base URL of the downstream OpenAI-compatible LLM endpoint.
# PCM appends "/v1/..." itself, so do NOT include a trailing "/v1"
# (it is stripped automatically if present).
PCM_LLM_URL=http://host.docker.internal:8000

# Optional fallback model used only when the client does not send one.
# The model defined by the client always takes precedence.
PCM_LLM_MODEL_NAME=meta-llama/Llama-3-8B-Instruct

# Bearer token for the LLM endpoint. Leave empty if not required.
PCM_LLM_API_KEY=

# Optional upstream-specific session header. When set it overrides the
# endpoint registry (app/endpoints.py): PCM derives the endpoint session id
# and emits it under this name, overriding any client value. Leave empty to
# let the registry decide from PCM_LLM_URL — the built-in rule maps an
# opencode.ai host to x-opencode-session. Set explicitly for other endpoints
# (e.g. X-Hermes-Session-Id). No effect for upstreams that need none
# (vLLM, OpenRouter, …).
PCM_LLM_SESSION_HEADER=

# Optional allowlist of alternate downstream base URLs a request may select for
# a single call via the X-PCM-LLM-URL header (comma-separated). Intended as a
# testing aid to try several engines without restarting PCM. Empty disables the
# override (the header is ignored). The header is stripped before forwarding.
#   PCM_LLM_URL_ALLOWLIST=http://localhost:9087,http://localhost:10080
PCM_LLM_URL_ALLOWLIST=

# Path inside the PCM container where the SQLite session database is stored.
# Override if you want to bind-mount a host directory for persistence.
PCM_DB_PATH=/data/sessions.db

# Session time-to-live, counted from the last activity (updated_at). Expired
# sessions are purged from the database. Duration with s/m/h/d/w units (seconds,
# minutes, hours, days, weeks); integer or float. Empty/0 disables expiry (default).
#   PCM_SESSION_TTL=30s    # 30 seconds
#   PCM_SESSION_TTL=360m   # 360 minutes
#   PCM_SESSION_TTL=6h     # 6 hours
#   PCM_SESSION_TTL=1.5d   # 1.5 days
#   PCM_SESSION_TTL=2w     # 2 weeks
PCM_SESSION_TTL=

# How often the background sweeper purges expired sessions (same duration
# syntax). Only used when PCM_SESSION_TTL is enabled. Default: 10m.
PCM_SESSION_TTL_SWEEP=10m

# Extra margin added to the TTL before a session is physically deleted (same
# duration syntax). A session is touched when it is resolved, but a long
# redaction/upstream/stream can still outlive the TTL; this margin keeps the
# sweeper from deleting an in-flight session's row and history. Default: 120s.
PCM_SESSION_TTL_GRACE=120s

# Maximum characters sent to the Triton privacy filter in a single inference
# call. Messages longer than this are split at natural boundaries (paragraph,
# line, sentence, word) and redacted chunk by chunk, then merged. This avoids
# the ensemble OOMing on very long inputs (e.g. large system prompts).
PCM_TRITON_MAX_CHARS=8000

# Log verbosity: DEBUG | INFO | WARNING | ERROR
# WARNING: DEBUG logs may contain PII (original span text from Triton).
PCM_LOG_LEVEL=INFO

# Comma-separated list of verbose event types to emit at DEBUG level.
# Requires PCM_LOG_LEVEL=DEBUG to be visible.
# Available events:
#   request_body      — incoming request body + X-Session-ID header (contains PII)
#   redaction_result  — full Triton output including detected spans  (contains PII)
#   llm_payload       — redacted payload + forwarded headers sent to the LLM (safe; auth/cookies redacted)
#   llm_raw_response  — raw LLM response before de-anonymisation     (safe, placeholders only)
#   session_state     — full session histories + privacy state        (contains PII)
#   response_body     — final de-anonymised response to the client   (contains PII)
# For streaming requests, llm_raw_response/response_body are emitted once at
# the end using the fully assembled message (response_body includes reasoning).
# Use * to enable all events.
# PCM_VERBOSE_LOG_EVENTS=llm_payload,llm_raw_response
# PCM_VERBOSE_LOG_EVENTS=*
PCM_VERBOSE_LOG_EVENTS=

# Privacy filtering scope (default-deny). Client history is untrusted: every
# message role and every known text field is redacted unless listed below as a
# pass-through. The *_FRESH sets apply to fresh conversations (cursor == 0) and
# do NOT inherit the resumed sets, so a replayed conversation cannot leak the
# de-anonymised assistant/tool turns. Empty = redact everything.
#
# SAFEGUARD: PCM's own assistant turns are stored and covered by the cursor, so
# they are never re-processed; an assistant/system message only reaches the
# filter when the client supplies one PCM did not store (replayed/reasoning-only
# /injected/branch). Those are untrusted, so a pass-through is ignored for the
# roles user/assistant/tool/function/developer and the fields content/reasoning/
# reasoning_content/name/tool-call arguments (a warning is logged). Only `system`
# and `refusal` can still be passed through.
# Roles: system, user, assistant, tool, function, developer, ...
PCM_PASSTHROUGH_ROLES=
PCM_PASSTHROUGH_ROLES_FRESH=
# Fields: content, reasoning, reasoning_content, refusal, name,
#         tool_calls.arguments, function_calls.arguments, function_call.arguments
PCM_PASSTHROUGH_FIELDS=
PCM_PASSTHROUGH_FIELDS_FRESH=

# Comma-separated labels the streaming de-anonymiser recognises as placeholder
# tags.  They must match the privacy-filter labels after normalisation
# (uppercase, non-alphanumerics replaced by "_").  Default covers the current
# openai/privacy-filter v2 taxonomy.  Only affects stream=true responses.
PCM_PLACEHOLDER_LABELS=ACCOUNT_NUMBER,PRIVATE_ADDRESS,PRIVATE_DATE,PRIVATE_EMAIL,PRIVATE_PERSON,PRIVATE_PHONE,PRIVATE_URL,SECRET

# Optional text appended (after a blank line) to the client's system prompt so
# the downstream LLM knows how to treat placeholder tags.  Empty = disabled.
# Injection happens after redaction and is persisted in the hidden (redacted)
# history only; the client never sees it.  Use \n for newlines in .env.
#
# PCM_SYSTEM_PROMPT_PII_INSTRUCTION="# Privacy Tags:\nThe user has a privacy filter active that anonymizes some information using the following tags placeholders.\n\n- <ACCOUNT_NUMBER_i>\n- <PRIVATE_ADDRESS_i>\n- <PRIVATE_DATE_i>\n- <PRIVATE_EMAIL_i>\n- <PRIVATE_PERSON_i>\n- <PRIVATE_PHONE_i>\n- <PRIVATE_URL_i>\n- <SECRET_i>\n\nwhere `_i` refers to the tag index. The user knows how to de-anonymize them. Whenever you need information related to them, treat them naturally as known information."
PCM_SYSTEM_PROMPT_PII_INSTRUCTION=

# ------------------------------------------------------------------------------
# Open WebUI service
# ------------------------------------------------------------------------------

# API key sent by Open WebUI to PCM. PCM ignores it by default (set
# PCM_LLM_API_KEY above for the real downstream key). Set any non-empty value.
OPENAI_API_KEY=dummy

ENABLE_PERSISTENT_CONFIG=False
ENABLE_FOLLOW_UP_GENERATION=False
ENABLE_TITLE_GENERATION=False
ENABLE_TAGS_GENERATION=False

# ------------------------------------------------------------------------------
# Open WebUI Pipelines service (pnyx-pipelines)
# ------------------------------------------------------------------------------

# API key that Open WebUI must supply when connecting to the Pipelines service.
# Set the same value in Open WebUI: Admin Panel → Settings → Connections → API Key.
PIPELINES_API_KEY=0p3n-w3bu!
