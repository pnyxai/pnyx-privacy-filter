name: "ensemble_model"
platform: "ensemble"
max_batch_size: ${MAX_BATCH_SIZE}

input [
  {
    name: "PROMPT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "LABELS"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "tokenizer_model"
      model_version: -1
      input_map {
        key: "PROMPT"
        value: "PROMPT"
      }
      output_map {
        key: "INPUT_IDS"
        value: "input_ids_internal"
      }
      output_map {
        key: "ATTN_MASK"
        value: "attn_mask_internal"
      }
    },
    {
      model_name: "main_model"
      model_version: -1
      input_map {
        key: "input_ids"
        value: "input_ids_internal"
      }
      input_map {
        key: "attention_mask"
        value: "attn_mask_internal"
      }
      output_map {
        key: "logits"
        value: "logits_internal"
      }
    },
    {
      model_name: "postprocessing_model"
      model_version: -1
      input_map {
        key: "LOGITS"
        value: "logits_internal"
      }
      input_map {
        key: "INPUT_IDS"
        value: "input_ids_internal"
      }
      input_map {
        key: "ATTN_MASK"
        value: "attn_mask_internal"
      }
      input_map {
        key: "PROMPT"
        value: "PROMPT"
      }
      output_map {
        key: "LABELS"
        value: "LABELS"
      }
    }
  ]
}
