name: "tokenizer_model"
backend: "python"
max_batch_size: ${MAX_BATCH_SIZE}

input [
  {
    name: "PROMPT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "INPUT_IDS"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "ATTN_MASK"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]

dynamic_batching {
  preferred_batch_size: [ 2 ]
  max_queue_delay_microseconds: 250000
}

parameters: {
  key: "EXECUTION_ENV_PATH"
  value: {
    string_value: "/opt/pnyx_pf.tar.gz"
  }
}
parameters: {
  key: "MAX_SEQUENCE_LENGTH"
  value: {
    string_value: "${MAX_SEQUENCE_LENGTH}"
  }
}
default_model_filename: "model.py"
